{
  "name": "family_bulletin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:exe": "md ..\\release 2>nul & del /q ..\\release\\family_bulletin.exe 2>nul & tauri build --no-bundle && copy src-tauri\\target\\release\\family_bulletin.exe ..\\release\\",
    "build:win": "md ..\\release 2>nul & del /q ..\\release\\family_bulletin.exe 2>nul & tauri build && copy src-tauri\\target\\release\\family_bulletin.exe ..\\release\\"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
