{
  "name": "family_media",
  "version": "0.1.0",
  "description": "Family media utility app",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc && vite build",
    "build:exe": "md ..\\release 2>nul & del /q ..\\release\\family_media.exe 2>nul & tauri build --no-bundle && copy src-tauri\\target\\release\\family_media.exe ..\\release\\",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
